# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=citadel_db
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@db:5432/citadel_db

# Security & Authentication
SECRET_KEY=your_super_secret_key_here
SUPER_ADMIN_EMAIL=admin@example.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cloudflare R2 / AWS S3
CLOUDFLARE_R2_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Infrastructure & CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
APP_ENV=development # Set to 'production' to enforce Secure cookies
